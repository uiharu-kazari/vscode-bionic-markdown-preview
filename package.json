{
  "name": "bionic-markdown-preview",
  "displayName": "Bionic Markdown Preview",
  "description": "Preview Markdown with adjustable word emphasis, reading settings, and optional gradient themes",
  "version": "0.2.8",
  "publisher": "BionicMarkdown",
  "icon": "media/icon.png",
  "license": "MIT",
  "homepage": "https://bionicmarkdown.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/uiharu-kazari/vscode-bionic-markdown-preview"
  },
  "bugs": {
    "url": "https://github.com/uiharu-kazari/vscode-bionic-markdown-preview/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "reading aid",
    "reading",
    "accessibility",
    "productivity"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bionicPreview.open",
        "title": "Bionic Preview",
        "category": "Bionic Markdown"
      },
      {
        "command": "bionicPreview.openToSide",
        "title": "Bionic Preview to Side",
        "category": "Bionic Markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bionicPreview.openToSide",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bionicPreview.open",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "bionicPreview.open",
          "when": "editorLangId == markdown"
        },
        {
          "command": "bionicPreview.openToSide",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Bionic Markdown Preview",
      "properties": {
        "bionicPreview.fixationPoint": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 5,
          "description": "Word emphasis level (1-5). Higher levels bold a larger proportion of each word."
        },
        "bionicPreview.opacity": {
          "type": "number",
          "default": 0.7,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Opacity of non-bolded text (0.1-1.0)"
        },
        "bionicPreview.gradientTheme": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "ocean",
            "sunset",
            "forest",
            "berry",
            "lavender",
            "autumn",
            "mint",
            "twilight",
            "coffee",
            "monochrome"
          ],
          "description": "Gradient theme for line coloring"
        },
        "bionicPreview.fontSize": {
          "type": "number",
          "default": 16,
          "minimum": 10,
          "maximum": 32,
          "description": "Font size in pixels"
        },
        "bionicPreview.lineHeight": {
          "type": "number",
          "default": 1.8,
          "minimum": 1,
          "maximum": 3,
          "description": "Line height multiplier"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ --noEmit && node scripts/build.mjs",
    "watch": "tsc -p ./ --noEmit && node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p ./ --noEmit",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.19.1",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.5.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "markdown-it": "^14.3.2"
  }
}
